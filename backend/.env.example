# Copy to .env for local development. Every deployed environment gets its
# config from real environment variables, not this file (see APP_ENV).

# ---- App ----
APP_ENV=local
APP_NAME=pos-backend
APP_URL=http://localhost:8080
LOG_LEVEL=debug
LOG_FORMAT=text

# ---- HTTP ----
APP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_BODY_LIMIT=2097152
HTTP_TRUSTED_PROXIES=

# ---- Database ----
DB_HOST=localhost
DB_PORT=5433
DB_USER=root
DB_PASSWORD=1234
DB_NAME=pos
DB_SSLMODE=disable
DB_TIMEZONE=UTC
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=10m
DB_LOG_LEVEL=warn
DB_AUTO_MIGRATE=true

# ---- Redis ----
# false falls back to process-local in-memory token denylist and rate limiter,
# both lost on restart and never shared between instances. Local dev only.
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# ---- JWT ----
# No default on purpose. Generate with: openssl rand -base64 48
JWT_ALGORITHM=HS256
JWT_ACCESS_SECRET=bee4c6e51dbbdfc93e690fa4ccde1e43.KOC91192C7DCA090
JWT_REFRESH_SECRET=2bebecddf8d2fd6a2c9d0c3bb7be9301edb9200b2fde12e8
JWT_ACCESS_TTL=12h
JWT_REFRESH_TTL=720h
JWT_ISSUER=pos-backend
JWT_AUDIENCE=pos-frontend

# ---- Bcrypt ----
BCRYPT_COST=12

# ---- Auth ----
AUTH_REGISTRATION_ENABLED=true
AUTH_REFRESH_COOKIE=false
AUTH_MAX_FAILED_LOGINS=10
AUTH_LOCKOUT_DURATION=15m
AUTH_PERMISSION_CACHE_TTL=5m

# ---- Security / CORS / Rate limiting ----
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Request-ID,X-Branch-Id
CORS_EXPOSED_HEADERS=X-Request-ID,Retry-After
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=3600
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1m
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW=15m

# ---- Swagger ----
SWAGGER_ENABLED=true
SWAGGER_ROUTE=/swagger

# ---- Seed ----
SEED_OWNER_EMAIL=owner@pos.local
SEED_OWNER_NAME=System Owner
SEED_OWNER_PASSWORD=
SEED_BUSINESS_NAME=Demo Grocery
SEED_BUSINESS_TYPE=grocery
SEED_DEMO=false
